{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  "compilerOptions": {
    "strict": true,
    // Matches the app, so a lookup that can miss has to be handled on both sides of the wire.
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Node runs these files directly by stripping types, so imports carry their real .ts extension
    // and nothing is ever emitted from here.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  }
}
