{
  "name": "auroraeditor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:app",
    "dev:app": "vite",
    "dev:server": "node --watch server/src/index.ts",
    "server": "node server/src/index.ts",
    "mcp": "node mcp/src/index.ts",
    "mcp:create-showcase": "node mcp/src/create-showcase.ts",
    "mcp:inspect-project": "node mcp/src/inspect-project.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build && tsc -p server/tsconfig.json --noEmit && tsc -p mcp/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "^4.4.5",
    "gifenc": "^1.0.3",
    "pinia": "^4.0.2",
    "pixi.js": "8.20.1",
    "three": "0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.13.5",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
